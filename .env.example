# =============================================================================
# Environment Variables for Hiver AI Support Agent
# =============================================================================
# Copy this file to .env and configure as needed:
#   cp .env.example .env
#
# NOTE: The project runs completely out-of-the-box without any external API keys
# because deterministic local models (sentence-transformers, FAISS) and mock
# providers are enabled by default for zero-cost, reproducible offline evaluation.
#
# NEVER commit your actual .env file or real secrets to version control.
# =============================================================================

# --- Optional LLM Generation & Judge Configuration ---
# Only required if using live OpenAI endpoints for generation or LLM judge evaluation.
# If omitted or left empty, the pipeline operates via deterministic local/mock providers.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30

# --- Optional Kaggle Dataset Download Credentials ---
# Required only if executing scripts/download_dataset.py via the Kaggle API.
# Alternatively, twcs.csv can be manually placed into data/raw/.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
